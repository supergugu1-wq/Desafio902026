# Copie este arquivo apenas para configurar as Environment Variables da Vercel.
# NÃO coloque valores reais neste arquivo antes de enviar ao GitHub.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICAVEL_OU_ANON

# Preferido em projetos Supabase novos:
SUPABASE_SECRET_KEY=SUA_CHAVE_SECRETA_DO_SERVIDOR
# Compatibilidade com projetos antigos (use apenas UM dos dois):
# SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

NEXT_PUBLIC_SITE_URL=https://seu-dominio.com

# Use o mesmo token configurado no webhook da Kiwify.
KIWIFY_WEBHOOK_SECRET=CRIE_UM_TOKEN_GRANDE_E_ALEATORIO
KIWIFY_PRODUCT_ID=ID_DO_PRODUTO_KIWIFY
ACCESS_DURATION_DAYS=90

# Acesso exclusivo do proprietário (somente na Vercel)
ADMIN_USERNAME=seu_usuario_admin
ADMIN_PASSWORD=use_uma_senha_forte_com_12_ou_mais_caracteres
ADMIN_SESSION_SECRET=gere_uma_chave_aleatoria_com_pelo_menos_32_caracteres
